# Copy to .env, fill in the empty values, then run ./install.sh
# .env holds passwords: keep it private (chmod 600), never commit it.

# --- Where the reports go -------------------------------------------------
ALERT_EMAIL_TO=
# Sender address; empty means the SMTP user
ALERT_EMAIL_FROM=

# --- Mail server (Gmail: use an app password, not your normal password) --
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# --- What to watch --------------------------------------------------------
# Every Docker Compose app on this server is watched, except these (comma separated)
IGNORE_APPS=ai-ops-assistant
# Short names for the email subject, as project=name pairs, e.g. my-shop-prod=shop,student-platform=students
APP_LABELS=
# How often to scan, in minutes
SCAN_EVERY_MINUTES=1
# Time zone for the times in the emails
TIMEZONE=Europe/Berlin

# --- AI investigation for causes the rules cannot find --------------------
# off: rules only (fast, no extra RAM). local: an Ollama model investigates (needs a strong machine)
AI_INVESTIGATION=off
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# --- Which parts to run ---------------------------------------------------
# n8n: start our own n8n. Leave it out if the server already runs n8n and set N8N_CONTAINER to it.
# metrics: Prometheus, Alertmanager, Grafana and the server metric alerts. demo: a demo service.
COMPOSE_PROFILES=n8n
N8N_CONTAINER=ai-ops-n8n

# --- Generated by install.sh if empty -------------------------------------
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
